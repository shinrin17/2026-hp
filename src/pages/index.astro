---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import { siteInfo } from '../config/site';
---
<SiteLayout title={`${siteInfo.name} | 写真・映像ポートフォリオ`} path="/" section="home">
  <section class="philosophy" aria-labelledby="philosophy-title">
    <p class="philosophy-name">RYOHTA MORIKAWA</p>
    <p class="philosophy-role">Photographer</p>
    <h1 id="philosophy-title" class="home-tagline"><span class="copy-phrase">その人と、</span><span class="copy-phrase">世界のあいだ。</span></h1>
  </section>
  <Hero />
  <p class="photography-link"><a href="/works/#photo">写真作品を見る ↗</a></p>
</SiteLayout>
