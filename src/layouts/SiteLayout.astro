---
import '../styles/main.css';
import SeoHead from '../components/SeoHead.astro';
import { siteInfo } from '../config/site';
import type { PageMetadata } from '../lib/seo';
interface Props extends PageMetadata {
  section?: 'home' | 'works' | 'about' | 'philosophy';
}
const { section, ...metadata } = Astro.props;
const type = metadata.openGraph?.type ?? 'website';
const ogPrefix = `og: https://ogp.me/ns#${type === 'website' ? '' : ` ${type}: https://ogp.me/ns/${type}#`}`;
---
<!doctype html>
<html lang="ja" prefix={ogPrefix}>
  <head>
    <SeoHead {...metadata} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="header">
      <a class="brand" href="/" aria-current={section === 'home' ? 'page' : undefined}>
        {siteInfo.name}
      </a>
      <nav aria-label="メインナビゲーション">
        <a href="/works/" aria-current={section === 'works' ? 'page' : undefined}>WORKS</a>
        <a href="/philosophy/" aria-label="PHILOSOPHY" aria-current={section === 'philosophy' ? 'page' : undefined}><span class="nav-label-full">PHILOSOPHY</span><span class="nav-label-short">PHIL.</span></a>
        <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>ABOUT</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer"><small>&copy; RYOHTA MORIKAWA</small></footer>
  </body>
</html>
